---

<aside class="social-button" aria-label="Быстрая связь в мессенджерах">
  <a
    href="https://vk.com"
    target="_blank"
    rel="noopener noreferrer"
    class="social-link vkontakte"
    title="ВКонтакте"
    aria-label="Написать в ВКонтакте"
  ></a>
  <a
    href="https://t.me"
    target="_blank"
    rel="noopener noreferrer"
    class="social-link telegram"
    title="Telegram"
    aria-label="Написать в Telegram"
  ></a>
  <a
    href="https://wa.me/74957773341"
    target="_blank"
    rel="noopener noreferrer"
    class="social-link whatsapp"
    title="WhatsApp"
    aria-label="Написать в WhatsApp"
  ></a>
  <a
    href="https://max.ru"
    target="_blank"
    rel="noopener noreferrer"
    class="social-link max"
    title="Мессенджер MAX"
    aria-label="Написать в мессенджере MAX"
  ></a>
</aside>

<style>
  .social-button {
    position: fixed;
    left: 15px;
    top: 140px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 80;
  }

  @media (max-width: 768px) {
    .social-button {
      left: 8px;
      top: 100px;
      gap: 10px;
    }
  }

  .social-link {
    width: 42px;
    height: 42px;
    display: block;
    border-radius: 50%;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .social-link:hover {
    transform: scale(1.12);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 500px) {
    .social-link {
      width: 36px;
      height: 36px;
    }
  }

  .social-link.vkontakte {
    background: url('/src/assets/images/icons/vk.svg') center / contain no-repeat;
  }

  .social-link.telegram {
    background: url('/src/assets/images/icons/telegram.svg') center / contain no-repeat;
  }

  .social-link.whatsapp {
    background: url('/src/assets/images/icons/whatsapp.svg') center / contain no-repeat;
  }

  .social-link.max {
    background: url('/src/assets/images/icons/max.svg') center / contain no-repeat;
  }
</style>
