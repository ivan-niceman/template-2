---
import { Image } from 'astro:assets';
import logoSvg from '../assets/images/logo.svg';
---

<header class="header">
  <div class="header__menu">
    <div class="container">
      <a href="/" class="logo" aria-label="Главная страница">
        <Image src={logoSvg} alt="логотип template-2" width="70" height="70" />
        <p class="logo-description">Ваш&nbsp;логотип</p>
      </a>

      <div class="header-feedback">
        <a class="phone" href="tel:+74957773341">+7 495 777 33 41</a>
        <button
          type="button"
          class="feedback-btn"
          data-content-title="давайте пообщаемся"
          data-title="Обратный звонок"
          aria-haspopup="dialog"
        >
          обратный&nbsp;звонок
        </button>
        <button type="button" class="burger-btn" aria-label="Открыть мобильное меню" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
      <div class="mobile-menu" aria-hidden="true"></div>
    
      <nav class="nav" aria-label="Основная навигация">
        <ul class="nav__list">
          <li><a href="#search-tour" class="nav__link">Поиск тура</a></li>
          <li><a href="#cruises" class="nav__link">Круизы</a></li>
          <li><a href="#stock" class="nav__link">Акции</a></li>
          <li><a href="#services" class="nav__link">Услуги</a></li>
          <li><a href="#about" class="nav__link">О нас</a></li>
          <li><a href="#feedback" class="nav__link">Отзывы</a></li>
        </ul>
        <div class="nav__contacts">
          <a href="tel:+74957773341" class="nav-phone">+7 495 777 33 41</a>
          <a
            href="https://t.me"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-telegram"
            aria-label="Подписаться на телеграм-канал"
          >
            <p class="telegram-channel">
              Подписаться на<br />telegram-канал
            </p>
            <svg
              width="40"
              height="40"
              viewBox="0 0 40 40"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M20 0C8.95 0 0 8.95 0 20C0 31.04 8.95 40 20 40C31.04 40 40 31.04 40 20C40 8.95 31.04 0 20 0ZM29.82 13.7L26.54 29.16C26.29 30.26 25.64 30.53 24.73 30.01L19.73 26.33L17.32 28.65C17.09 28.95 16.72 29.14 16.32 29.14L16.66 24.05L25.93 15.68C26.33 15.33 25.84 15.12 25.31 15.48L13.86 22.69L8.93 21.15C7.86 20.81 7.83 20.08 9.15 19.56L28.43 12.13C29.33 11.8 30.11 12.34 29.82 13.7Z"
                fill="#FFFFFF"
              />
            </svg>
          </a>
        </div>
      </nav>
    </div>
  </div>

</header>

<style>
  .header {
    position: relative;
    z-index: 20;
  }

  .header__menu {
    box-shadow: 0px 20px 20px 0px rgba(0, 0, 0, 0.1);
    background: rgba(196, 171, 206, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.3s ease;
  }

  .header__menu .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    column-gap: 20px;
    padding-top: 15px;
    padding-bottom: 15px;
  }

  .logo {
    display: flex;
    align-items: center;
    column-gap: 20px;
  }

  .logo img {
    width: 70px;
    height: 70px;
    border-radius: 12px;
  }

  .logo-description {
    font-family: 'Roboto', 'Inter', sans-serif;
    color: #000;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .header-feedback {
    display: flex;
    justify-content: space-between;
    align-items: center;
    column-gap: 15px;
    max-width: 670px;
    width: 100%;
  }

  @media (max-width: 768px) {
    .header-feedback {
      max-width: 480px;
    }
  }

  @media (max-width: 680px) {
    .header-feedback {
      max-width: fit-content;
    }
    .header-feedback .phone {
      display: none;
    }
    .header-feedback .feedback-btn {
      display: none;
    }
  }

  .burger-btn {
    position: relative;
    display: flex;
    min-width: 40px;
    height: 19px;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .burger-btn > span {
    background-color: var(--color-btn);
    height: 3px;
    width: 100%;
    transition: transform 0.3s ease, background-color 0.3s ease, opacity 0.3s ease;
  }

  .burger-btn.burger-visible {
    justify-content: center;
    z-index: 101;
  }

  .burger-btn.burger-visible > span {
    position: absolute;
    background-color: #000;
    width: 100%;
  }

  .burger-btn.burger-visible > span:nth-child(1) {
    transform: rotate(45deg);
    background-color: var(--color-btn-hover);
  }

  .burger-btn.burger-visible > span:nth-child(2) {
    opacity: 0;
  }

  .burger-btn.burger-visible > span:nth-child(3) {
    transform: rotate(-45deg);
    background-color: var(--color-btn);
  }

  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background-color: rgba(0, 0, 0, 0.5);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100vh;
    height: 100dvh;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    cursor: pointer;
    z-index: 90;
  }

  .mobile-menu.mobile-menu_active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    position: fixed;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    top: 0;
    right: 0;
    transform: translateX(100%);
    width: 320px;
    max-width: 85vw;
    height: 100vh;
    height: 100dvh;
    background-color: #fff;
    padding: 100px 20px 35px;
    transition: transform 0.3s ease, opacity 0.3s ease, visibility 0.3s ease;
    z-index: 100;
    box-shadow: -5px 0 25px rgba(0, 0, 0, 0.15);
  }

  .nav.nav_active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  .nav__list {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
  }

  .nav__link {
    color: #000;
    font-size: 18px;
    font-weight: 700;
    transition: color 0.3s ease;
  }

  .nav__link:hover {
    color: var(--color-btn-hover);
  }

  .nav__contacts {
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid #E2E8F0;
  }

  .nav-phone {
    display: flex;
    justify-content: space-between;
    align-items: center;
    column-gap: 20px;
    color: var(--color-slate);
    font-size: 18px;
    font-weight: 700;
    line-height: 22px;
  }

  .nav-phone::after {
    content: '';
    background: url('/src/assets/images/icons/phone.svg') center / cover no-repeat;
    width: 28px;
    height: 28px;
    display: inline-block;
  }

  .nav-telegram {
    margin-top: 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #29A9EB;
    padding: 10px 15px;
    border-radius: 8px;
    color: #fff;
  }

  .telegram-channel {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .nav-telegram svg path {
    fill: #FFFFFF;
  }
</style>

<script>
  // Clean zero-dependency native navigation controller
  function initHeaderNav() {
    const burgerBtn = document.querySelector('.burger-btn');
    const mobileMenu = document.querySelector('.mobile-menu');
    const navigation = document.querySelector('.nav');
    const navLinks = document.querySelectorAll('.nav__link');

    if (!burgerBtn || !mobileMenu || !navigation) return;

    function openMenu() {
      if (!mobileMenu || !navigation || !burgerBtn) return;

      mobileMenu.classList.add('mobile-menu_active');
      navigation.classList.add('nav_active');
      burgerBtn.classList.add('burger-visible');
      burgerBtn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('body-hidden');
    }

    function closeMenu() {
      if (!mobileMenu || !navigation || !burgerBtn) return;

      mobileMenu.classList.remove('mobile-menu_active');
      navigation.classList.remove('nav_active');
      burgerBtn.classList.remove('burger-visible');
      burgerBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('body-hidden');
    }

    burgerBtn.addEventListener('click', () => {
      if (navigation.classList.contains('nav_active')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileMenu.addEventListener('click', closeMenu);

    navLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        closeMenu();
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const target = document.querySelector(href);
          if (target) {
            event.preventDefault();
            const headerHeight = document.querySelector('.header__menu')?.clientHeight || 80;
            const targetPos = target.getBoundingClientRect().top + window.scrollY - headerHeight;
            window.scrollTo({
              top: targetPos,
              behavior: 'smooth'
            });
          }
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navigation.classList.contains('nav_active')) {
        closeMenu();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderNav);
  } else {
    initHeaderNav();
  }
</script>
