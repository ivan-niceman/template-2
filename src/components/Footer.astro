---
import { Image } from 'astro:assets';
import logoSvg from '../assets/images/logo.svg';
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__info">
      <div class="footer__contacts">
        <a href="/" class="logo" aria-label="template-2 главная страница">
          <Image src={logoSvg} alt="логотип" width="70" height="70" />
          <p class="logo-description">Ваш&nbsp;логотип</p>
        </a>
        <button
          type="button"
          class="feedback-btn footer-feedback-btn"
          data-content-title="давайте пообщаемся"
          data-title="Обратный звонок"
        >
          обратный&nbsp;звонок
        </button>
      </div>

      <nav class="footer__nav" aria-label="Навигация в футере">
        <ul>
          <li><a href="#search-tour" class="nav__link">Поиск тура</a></li>
          <li><a href="#about" class="nav__link">О нас</a></li>
          <li><a href="#cruises" class="nav__link">Круизы</a></li>
          <li><a href="#feedback" class="nav__link">Отзывы</a></li>
          <li><a href="#stock" class="nav__link">Акции</a></li>
          <li><a href="#services" class="nav__link">Услуги</a></li>
        </ul>
      </nav>

      <div class="footer__address">
        <a class="phone" href="tel:+74957773341">+7 495 777 33 41</a>
        <div>
          <p>пн-пт с 9:00 до 19:00</p>
          <p>Адрес: г. Москва, ул. Ленина 19, офис 301</p>
        </div>
      </div>
    </div>

    <div class="footer__privacy">
      <div class="footer__legal-links">
        <a href="/privacy">Положение об обработке персональных данных</a>
        <a href="/consent">Согласие на обработку персональных данных</a>
        <button type="button" class="cookie-settings-btn" id="open-cookie-settings" data-open-cookie-settings>
          Настройки cookie
        </button>
      </div>
      <p class="footer__disclaimer">
        Информация на сайте не является публичной офертой и носит исключительно информационный характер.<br />
        ИНН 4722222222222 · ОГРН 3777777777777
      </p>
    </div>
  </div>

  <a
    class="nice-dev"
    href="https://nice-dev.ru/"
    target="_blank"
    rel="noreferrer"
  >
    &copy; Nice Dev Web-Studio 2020 – <span class="current-year">{currentYear}</span>
  </a>
</footer>

<style>
  .footer {
    margin-top: 100px;
    padding: 60px 0 25px;
    background-color: var(--color-gray-footer);
    color: #FFFFFF;
  }

  @media (max-width: 768px) {
    .footer {
      margin-top: 50px;
      padding: 40px 0 20px;
    }
  }

  .footer__info {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 40px;
  }

  @media (max-width: 500px) {
    .footer__info {
      justify-content: center;
    }
  }

  .footer__contacts {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    row-gap: 30px;
  }

  .footer__contacts .logo {
    display: flex;
    align-items: center;
    column-gap: 15px;
  }

  .footer__contacts .logo-description {
    color: #FFFFFF;
  }

  .footer__nav ul {
    display: grid;
    grid-template-columns: max-content max-content;
    gap: 25px 80px;
  }

  @media (max-width: 500px) {
    .footer__nav ul {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  .footer__nav .nav__link {
    font-size: 16px;
    font-weight: 500;
    color: #FFFFFF;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .footer__nav .nav__link:hover {
    color: var(--color-btn-hover);
  }

  .footer__address {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: right;
    row-gap: 15px;
  }

  .footer__address .phone {
    color: #FFFFFF;
  }

  .footer__address p {
    color: #E2E8F0;
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .footer__address {
      text-align: left;
    }
  }
  @media (max-width: 500px) {
    .footer__address {
      text-align: center;
    }
  }

  .footer__privacy {
    margin-top: 40px;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer__legal-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 15px;
  }

  .footer__legal-links a,
  .cookie-settings-btn {
    font-size: 12px;
    font-weight: 500;
    color: #FFFFFF;
    text-decoration: underline;
    text-underline-offset: 3px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    line-height: 1.4;
    transition: color 0.2s ease;
    text-align: left;
    font-family: inherit;
  }

  .footer__legal-links a:hover,
  .cookie-settings-btn:hover {
    color: var(--color-btn-hover);
  }

  .footer__disclaimer {
    margin-top: 10px;
    font-size: 12px;
    color: #94A3B8;
  }

  .current-year {
    font-weight: 600;
  }
</style>
