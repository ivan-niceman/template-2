---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SearchTour from '../components/SearchTour.astro';
import Cruises from '../components/Cruises.astro';
import PromoBanner from '../components/PromoBanner.astro';
import Services from '../components/Services.astro';
import AboutStats from '../components/AboutStats.astro';
import Team from '../components/Team.astro';
import Reviews from '../components/Reviews.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import ModalForm from '../components/ModalForm.astro';
import ModalSuccess from '../components/ModalSuccess.astro';
import FloatingMessengers from '../components/FloatingMessengers.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<Layout
  title="Горящие туры и круизы по России и всему земному шару | template-2"
  description="Лечение в санаториях, отдых на море, активные и экскурсионные поездки, круизы — все для вас! Быстрый и бесплатный подбор тура по выгодным ценам."
>
  <Header />
  <main class="main">
    <Hero />
    <SearchTour />
    <Cruises />
    <PromoBanner />
    <Services />
    <AboutStats />
    <Team />
    <Reviews />
    <Partners />
  </main>
  <Footer />

  <!-- Modals & Interactive Overlays -->
  <ModalForm />
  <ModalSuccess />
  <FloatingMessengers />
  <ScrollToTop />
  <CookieBanner />
</Layout>
